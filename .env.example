# =============================================================================
# AI-Driven Phishing Email Detection Using NLP — Environment Variables
# Copy this file to `.env` and adjust values as needed.
# =============================================================================

# --- Training / Data ---
# Reuse the previously-generated cleaned dataset instead of re-cleaning raw
# text (speeds up repeated training runs dramatically).
USE_CACHED_CLEANED_DATA=true

# Train/test split ratio (fraction used for testing).
TEST_SIZE=0.2

# Reproducibility seed for all randomized operations.
RANDOM_STATE=42

# Use stratified splitting to preserve class distribution.
STRATIFY=true

# TF-IDF vocabulary size (top-N terms).
TFIDF_MAX_FEATURES=10000

# Truncate email text longer than this many characters during cleaning.
MAX_TEXT_LENGTH=50000

# Discard emails whose cleaned text is shorter than this.
MIN_TEXT_LENGTH=10

# --- Logging ---
LOG_LEVEL=INFO

# --- REST API ---
API_HOST=0.0.0.0
API_PORT=8000

# --- Streamlit ---
STREAMLIT_PORT=8501

# --- Prediction history ---
MAX_PREDICTION_HISTORY=50
